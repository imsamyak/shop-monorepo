# One URL for every service (a gateway), or set ECOM_<SERVICE>_URL per service
# (ECOM_IDENTITY_URL, ECOM_CATALOG_URL, ECOM_LISTING_URL, ECOM_CHECKOUT_URL, ECOM_ORDER_URL, ECOM_INVENTORY_URL,
# ECOM_ASSET_URL). Leave them unset to use the local ports (8081 ... 8088).
# ECOM_API_URL=http://localhost:8080
