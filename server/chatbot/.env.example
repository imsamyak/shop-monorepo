# Copy this file to ".env" and fill in your values.

# Your Gemini API key (https://aistudio.google.com/apikey)
# (the repo-root .env is read too, and may call it CHATBOT_API_KEY_GEMINI)
GEMINI_API_KEY=

# Which Gemini model to use (list: https://ai.google.dev/gemini-api/docs/models)
MODEL=gemini-3.5-flash

# Port the chatbot runs on
PORT=4001

# The platform services are reached through @shop/platform-sdk, which reads
# ECOM_API_URL (one URL in front of every service) or one variable per service
# (ECOM_IDENTITY_URL, ECOM_CATALOG_URL, ECOM_LISTING_URL, ECOM_CHECKOUT_URL, ECOM_ORDER_URL).
# Leave them out to use the local defaults (localhost:8081 ... 8088).

# Set to production to turn off the test page at /
NODE_ENV=development
