# Copy to bootstrap/dev/.env and fill in. This file is read by docker compose; .env itself is git-ignored.

# The hosted RabbitMQ (for example CloudAMQP). For amqps:// use port 5671 and RABBITMQ_SSL=true; the vhost is usually the user name.
RABBITMQ_HOST=
RABBITMQ_PORT=5671
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=
RABBITMQ_SSL=true

# The S3 bucket the asset service writes product photos to (imsamyak.shop-asset-dev, ap-south-1).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Gemini key for the chatbot.
CHATBOT_API_KEY_GEMINI=

# Optional: the password of the containers' Postgres (nothing outside the machine can reach it).
# POSTGRES_PASSWORD=ecom
